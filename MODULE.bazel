bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_scala", version = "7.3.0")

# VSCode/Cursor Metals extension needs explicit declaration
bazel_dep(name = "rules_python", version = "2.3.3")
bazel_dep(name = "rules_java", version = "9.9.0")

register_toolchains("//:custom_scala_toolchain")

scala_version = "3.3.8"

scala_config = use_extension(
    "@rules_scala//scala/extensions:config.bzl",
    "scala_config",
)
scala_config.settings(scala_version = scala_version)

scala_deps = use_extension(
    "@rules_scala//scala/extensions:deps.bzl",
    "scala_deps",
)
scala_deps.settings(
    fetch_sources = True,
)
scala_deps.scala()
scala_deps.scalatest()

bazel_dep(name = "rules_jvm_external", version = "7.1")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    artifacts = [
        "com.softwaremill.sttp.tapir:tapir-core_3:1.13.31",
    ],
    fetch_sources = True,
    lock_file = "//:maven_install.json",
    repositories = [
        "https://repo1.maven.org/maven2",
    ],
)
use_repo(maven, "maven")

bazel_dep(name = "rules_pkg", version = "1.2.0")
bazel_dep(name = "rules_oci", version = "2.3.0")

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci")
oci.pull(
    name = "java_temurin",
    digest = "sha256:a051234f864d7ab78bf0188c3c540ac06c711a3b566f00f246be37073cc99dce",  # multi-arch index digest
    image = "eclipse-temurin",
    # Multi-arch: the base is selected by target CPU, so images are native to the host
    # that builds them. Run `:push` from CI (linux/amd64), not from an arm64 laptop.
    platforms = [
        "linux/amd64",
        "linux/arm64/v8",
    ],
    tag = "25.0.2_10-jre-noble",
)
use_repo(
    oci,
    "java_temurin",
    "java_temurin_linux_amd64",
    "java_temurin_linux_arm64_v8",
)
